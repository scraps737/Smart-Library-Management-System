# Athenaeum API — copy to server/.env and adjust. Never commit the real file.

NODE_ENV=development

# 4110 rather than 4000, so another project can keep the usual port.
PORT=4110

# MongoDB connection string. A local server is fine for development.
MONGODB_URI=mongodb://127.0.0.1:27017/athenaeum

# Signing key for session tokens. Generate a unique value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Origin allowed to send credentialed requests in development (the web client).
CLIENT_ORIGIN=http://localhost:5180

# Circulation policy
LOAN_PERIOD_DAYS=21
MAX_RENEWALS=2
